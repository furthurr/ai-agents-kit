{
  "filename": "documentation-orchestrator.md",
  "frontmatter": {
    "description": "Ayuda a entender el proyecto, localizar código y revisar, iniciar o actualizar su documentación. También comprueba si está lista para publicar; pide lo que necesitas en lenguaje natural.",
    "tools": [
      "read",
      "write",
      "shell",
      "web"
    ],
    "permissions": {
      "rules": [
        { "capability": "fs_write", "match": ["**"], "exclude": ["AGENTS.md", ".navigator/**", ".architecture/**", ".data/**", ".design/**", ".quality/**", ".security/**"], "effect": "deny" },
        { "capability": "fs_write", "effect": "ask" },
        { "capability": "shell", "effect": "ask" },
        { "capability": "subagent", "effect": "ask" },
        { "capability": "shell", "match": ["rm *"], "effect": "deny" },
        { "capability": "shell", "match": ["rm -rf *"], "effect": "deny" },
        { "capability": "shell", "match": ["git push*"], "effect": "deny" },
        { "capability": "shell", "match": ["git commit*"], "effect": "deny" },
        { "capability": "shell", "match": ["git tag*"], "effect": "deny" },
        { "capability": "shell", "match": ["git reset --hard*"], "effect": "deny" },
        { "capability": "shell", "match": ["git checkout -f*"], "effect": "deny" },
        { "capability": "shell", "match": ["git checkout --force*"], "effect": "deny" },
        { "capability": "shell", "match": ["git branch -D*"], "effect": "deny" },
        { "capability": "shell", "match": ["git clean*"], "effect": "deny" }
      ]
    }
  }
}
