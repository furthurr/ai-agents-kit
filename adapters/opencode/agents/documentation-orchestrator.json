{
  "filename": "documentation-orchestrator.md",
  "frontmatter": {
    "description": "Coordina status, bootstrap y sincronización de documentación canónica tras petición; conserva aprobaciones y gates. Úsalo para sync-check, sync-domain, release-check y coordinación multidominio, no para localizar archivos puntuales.",
    "mode": "all",
    "temperature": 0.2,
    "permission": {
      "edit": {
        "*": "deny",
        ".navigator/*": "ask",
        ".architecture/*": "ask",
        ".data/*": "ask",
        ".design/*": "ask",
        ".quality/*": "ask",
        ".security/*": "ask",
        "*/.navigator/*": "ask",
        "*/.architecture/*": "ask",
        "*/.data/*": "ask",
        "*/.design/*": "ask",
        "*/.quality/*": "ask",
        "*/.security/*": "ask"
      },
      "webfetch": "allow",
      "external_directory": "ask",
      "task": {
        "*": "deny",
        "code-review": "ask"
      },
      "bash": {
        "*": "ask",
        "git *": "deny",
        "git status*": "ask",
        "git log*": "ask",
        "git diff*": "ask",
        "git show*": "ask",
        "git rev-parse*": "ask",
        "rm *": "deny",
        "git clean*": "deny"
      }
    }
  }
}
