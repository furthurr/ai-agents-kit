{
  "filename": "documentation-orchestrator.md",
  "frontmatter": {
    "description": "Ayuda a entender el proyecto, localizar código y revisar, iniciar o actualizar su documentación. También comprueba si está lista para publicar; pide lo que necesitas en lenguaje natural.",
    "mode": "all",
    "temperature": 0.2,
    "permission": {
      "edit": {
        "*": "deny",
        "README.md": "ask",
        "*/README.md": "ask",
        "readme.md": "ask",
        "*/readme.md": "ask",
        "AGENTS.md": "ask",
        "*/AGENTS.md": "ask",
        "docs/*.md": "ask",
        "*/docs/*.md": "ask",
        ".navigator/*": "ask",
        ".architecture/*": "ask",
        ".data/*": "ask",
        ".design/*": "ask",
        ".quality/*": "ask",
        ".security/*": "ask",
        "*/.navigator/*": "ask",
        "*/.architecture/*": "ask",
        "*/.data/*": "ask",
        "*/.design/*": "ask",
        "*/.quality/*": "ask",
        "*/.security/*": "ask"
      },
      "webfetch": "allow",
      "external_directory": "ask",
      "task": {
        "*": "deny",
        "code-review": "ask"
      },
      "bash": {
        "*": "ask",
        "git *": "deny",
        "git status*": "ask",
        "git log*": "ask",
        "git diff*": "ask",
        "git show*": "ask",
        "git rev-parse*": "ask",
        "rm *": "deny",
        "git clean*": "deny"
      }
    }
  }
}
